rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // ADMIN AUTHORIZATION
    // ---------------------------------------------------------
    // An approved administrator has a document whose ID equals their
    // Firebase Authentication UID:
    //
    //     admins/{firebaseUid}
    //
    // The admin dashboard cannot create these documents. Add them manually
    // in the Firebase Console so a random authenticated Google user cannot
    // promote themselves to administrator.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A signed-in user may check ONLY their own admin document.
    // Nobody can create/change/delete admin authorization from the website.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------
    // CLIENT DIRECTORY
    // ---------------------------------------------------------
    match /clients/{clientId} {
      // Public registration may CREATE a narrowly validated client record.
      allow create: if
        request.resource.data.keys().hasAll([
          'firstName', 'lastName', 'email', 'phone',
          'marketingConsent', 'consentAt', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'phone',
          'marketingConsent', 'consentAt', 'createdAt'
        ]) &&
        request.resource.data.firstName is string &&
        request.resource.data.firstName.size() > 0 &&
        request.resource.data.firstName.size() <= 60 &&
        request.resource.data.lastName is string &&
        request.resource.data.lastName.size() > 0 &&
        request.resource.data.lastName.size() <= 60 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 3 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 6 &&
        request.resource.data.phone.size() <= 30 &&
        request.resource.data.marketingConsent is bool &&
        request.resource.data.marketingConsent == true &&
        request.resource.data.consentAt == request.time &&
        request.resource.data.createdAt == request.time;

      // Only approved admins can view/manage registered clients.
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // APPOINTMENTS
    // ---------------------------------------------------------
    match /appointments/{appointmentId} {
      allow read: if isAdmin();

      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll([
          'clientId', 'clientName', 'clientEmail', 'clientPhone',
          'service', 'startAt', 'status', 'notes',
          'confirmationEmailSent', 'confirmationSmsSent',
          'reminderEmailSent', 'reminderSmsSent',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.clientId is string &&
        request.resource.data.clientName is string &&
        request.resource.data.clientEmail is string &&
        request.resource.data.clientPhone is string &&
        request.resource.data['service'] is string &&
        request.resource.data['service'].size() > 0 &&
        request.resource.data['service'].size() <= 120 &&
        request.resource.data.startAt is timestamp &&
        request.resource.data.status in ['scheduled', 'confirmed', 'completed', 'cancelled'] &&
        request.resource.data.notes is string &&
        request.resource.data.notes.size() <= 500 &&
        request.resource.data.confirmationEmailSent == false &&
        request.resource.data.confirmationSmsSent == false &&
        request.resource.data.reminderEmailSent == false &&
        request.resource.data.reminderSmsSent == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isAdmin() &&
        request.resource.data.clientId is string &&
        request.resource.data.clientName is string &&
        request.resource.data.clientEmail is string &&
        request.resource.data.clientPhone is string &&
        request.resource.data['service'] is string &&
        request.resource.data['service'].size() > 0 &&
        request.resource.data['service'].size() <= 120 &&
        request.resource.data.startAt is timestamp &&
        request.resource.data.status in ['scheduled', 'confirmed', 'completed', 'cancelled'] &&
        request.resource.data.notes is string &&
        request.resource.data.notes.size() <= 500 &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin();
    }

    // Deny anything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
